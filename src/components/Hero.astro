---
// Hero.astro - Fully responsive Hero section matching exact Figma banner design
import CountryPhoneInput from './CountryPhoneInput.astro';
---

<section class="relative w-full min-h-screen bg-cover bg-center flex items-center pt-32 sm:pt-36 lg:pt-44 pb-16 lg:pb-24 font-montserrat overflow-hidden" style="background-image: url('/hero-bg.jpg');">
  <!-- Gradient Overlay matching Figma (#000000 100% to #000000 85%) -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/85 to-black/75 -z-0"></div>

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 w-full relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Left Column: Content & Consultation Banner -->
    <div class="lg:col-span-7 space-y-6 text-white">
      
      <!-- Subheading -->
      <h3 class="text-lg sm:text-2xl font-semibold tracking-tight text-white/90">
        Expert Book Publishing Services
      </h3>

      <!-- Main Headline -->
      <h1 class="font-nunito text-4xl sm:text-6xl xl:text-[68px] font-bold tracking-tight leading-[1.1] text-white max-w-2xl line-clamp-2">
        For Aspiring <br class="hidden sm:inline" />
        <span class="text-white">Authors</span>
      </h1>

      <!-- Description Paragraph -->
      <p class="text-slate-300 text-xs sm:text-sm lg:text-base leading-relaxed max-w-2xl font-normal">
        Turn your manuscript into a commercially successful book. From ghostwriting and developmental editing to custom cover design and worldwide distribution across Amazon, Apple Books, and Barnes & Noble, Fleck Publisher guides your author journey with precision and care.
      </p>

      <!-- Consultation Banner (Exact Pill design matching Figma image) -->
      <a 
        href="#hero-consultation-form" 
        class="w-full max-w-xl rounded-[24px] sm:rounded-[28px] overflow-hidden flex items-stretch shadow-2xl border border-white/10 group cursor-pointer hover:shadow-orange-950/40 transition-all block"
      >
        <!-- Left Brown Part -->
        <div class="bg-[#943C00] text-white p-4 sm:p-5 flex-1 flex flex-col justify-center space-y-1">
          <h4 class="text-white text-sm sm:text-lg lg:text-xl font-bold leading-snug tracking-tight">
            Get Free 1 Hour Consultation Valued At $250
          </h4>
          <p class="text-white/90 text-[10px] sm:text-xs font-medium leading-tight">
            Send Us Your Details And Our Consultant Will Reach You Back At Your Specified Time
          </p>
        </div>

        <!-- Right Beige Pill Cap -->
        <div class="w-12 sm:w-20 bg-[#E8D9CB] shrink-0 group-hover:bg-[#dfcdbd] transition-colors flex items-center justify-center">
          <svg class="w-5 h-5 text-[#943C00] stroke-[2.5] transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

      <!-- Book Now Button -->
      <div class="pt-2">
        <a 
          href="#hero-consultation-form" 
          class="inline-flex items-center justify-center px-7 sm:px-8 py-3 bg-white text-[#3D2E61] font-semibold text-sm sm:text-[15px] rounded-xl hover:bg-slate-100 hover:shadow-xl active:scale-[0.98] transition-all duration-200 cursor-pointer shadow-md"
        >
          Book Now
        </a>
      </div>

      <!-- Social Proof / Join Badge Line -->
      <div class="space-y-3 pt-2">
        <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold text-white/90">
          <span>Join</span>
          <img src="/icons/fluent-color_star-16.svg" alt="Star Icon" class="w-4 h-4 shrink-0" />
          <span class="text-white font-bold">2,389+</span>
          <span class="text-slate-200 font-medium">Writers Who Got Their Book Published.</span>
        </div>

        <!-- Logos Row: Google My Business, Bark, Reviews.io (100px height matching Figma) -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-7 pt-2">
          <!-- Google My Business Logo (100x100) -->
          <div class="flex items-center justify-center h-[85px] sm:h-[100px] shrink-0">
            <img 
              src="/icons/google-my-business.png" 
              alt="Google My Business" 
              class="h-[85px] sm:h-[100px] w-auto object-contain" 
            />
          </div>

          <!-- Bark Logo (100x100) -->
          <div class="flex items-center justify-center h-[85px] sm:h-[100px] shrink-0">
            <img 
              src="/icons/bark.png" 
              alt="Bark" 
              class="h-[85px] sm:h-[100px] w-auto object-contain" 
            />
          </div>

          <!-- Reviews.io Logo (124x100) -->
          <div class="flex items-center justify-center h-[85px] sm:h-[100px] shrink-0">
            <img 
              src="/icons/reviews-io.png" 
              alt="Reviews.io" 
              class="h-[85px] sm:h-[100px] w-auto object-contain" 
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Form Card -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end">
      <div id="hero-consultation-form" class="w-full max-w-[460px] bg-white rounded-[24px] sm:rounded-[28px] p-5 sm:p-8 shadow-2xl text-slate-900 border border-slate-100/20 font-montserrat scroll-mt-28">
        
        <!-- Form Header -->
        <div class="text-center space-y-1 mb-5 sm:mb-6">
          <h2 class="text-xl sm:text-[26px] font-bold text-[#7A1C2C] leading-tight line-clamp-2">
            Up To 50% Off On All Services!
          </h2>
          <p class="text-[#7A1C2C] text-xs sm:text-sm font-semibold tracking-wide">
            Limited Time Only
          </p>
        </div>

        <!-- Form Elements -->
        <form id="hero-submit-form" class="space-y-3.5">
          
          <!-- Full Name -->
          <div>
            <input 
              type="text" 
              placeholder="Full Name*" 
              required
              class="w-full bg-[#F0EFF4] border-0 rounded-xl px-4 py-3 sm:py-3.5 text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all"
            />
          </div>

          <!-- Phone Number input with country selector & flag icons -->
          <CountryPhoneInput 
            id="hero-phone"
            name="phone"
            placeholder="Phone Number"
            required={true}
            wrapperClass="bg-[#F0EFF4] rounded-xl px-3 py-1 border-0"
            inputClass="py-2 sm:py-2.5 text-xs sm:text-sm font-medium text-slate-800"
          />

          <!-- Email -->
          <div>
            <input 
              type="email" 
              placeholder="Email*" 
              required
              class="w-full bg-[#F0EFF4] border-0 rounded-xl px-4 py-3 sm:py-3.5 text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all"
            />
          </div>

          <!-- Select Services Checklist Section -->
          <div class="pt-1">
            <label class="block text-xs font-semibold text-slate-700 mb-2">
              Select Services
            </label>
            
            <div class="grid grid-cols-2 gap-2 sm:gap-2.5">
              
              <!-- Checkbox Item 1 (Checked default) -->
              <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                <input type="checkbox" checked class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Publishing</span>
              </label>

              <!-- Checkbox Item 2 -->
              <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Marketing</span>
              </label>

              <!-- Checkbox Item 3 -->
              <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Writing</span>
              </label>

              <!-- Checkbox Item 4 -->
              <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Trailer Service</span>
              </label>

              <!-- Checkbox Item 5 -->
              <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Editing Services</span>
              </label>

              <!-- Checkbox Item 6 -->
              <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Design Services</span>
              </label>

            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button 
              type="submit" 
              id="hero-submit-btn"
              class="w-full bg-[#3D2E61] hover:bg-[#4d3a7a] active:scale-[0.99] text-white font-bold text-sm sm:text-base py-3 sm:py-3.5 rounded-xl shadow-lg transition-all duration-200 cursor-pointer"
            >
              Submit
            </button>
          </div>

        </form>

        <script is:inline>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('hero-submit-form');
            const btn = document.getElementById('hero-submit-btn');
            if (form && btn) {
              form.addEventListener('submit', (e) => {
                e.preventDefault();
                const originalText = btn.textContent;
                btn.textContent = 'Submitting...';
                btn.disabled = true;
                setTimeout(() => {
                  btn.textContent = '✓ Thank You! We Will Contact You Shortly';
                  btn.classList.remove('bg-[#3D2E61]', 'hover:bg-[#4d3a7a]');
                  btn.classList.add('bg-emerald-700');
                  form.reset();
                  setTimeout(() => {
                    btn.textContent = originalText;
                    btn.disabled = false;
                    btn.classList.remove('bg-emerald-700');
                    btn.classList.add('bg-[#3D2E61]', 'hover:bg-[#4d3a7a]');
                  }, 4000);
                }, 700);
              });
            }
          });
        </script>

      </div>
    </div>

  </div>
</section>
