---
// CountryPhoneInput.astro - International Phone Input with Country Flag Icons
export interface Props {
  id?: string;
  name?: string;
  placeholder?: string;
  required?: boolean;
  wrapperClass?: string;
  inputClass?: string;
}

const {
  id = "phone-input",
  name = "phone",
  placeholder = "Phone Number",
  required = false,
  wrapperClass = "bg-[#F0EFF4] rounded-xl px-3 py-1",
  inputClass = "py-2.5 text-xs sm:text-sm font-medium text-slate-800",
} = Astro.props;

export const countryCodes = [
  { code: "+1", iso: "us", name: "United States" },
  { code: "+44", iso: "gb", name: "United Kingdom" },
  { code: "+1", iso: "ca", name: "Canada" },
  { code: "+61", iso: "au", name: "Australia" },
  { code: "+971", iso: "ae", name: "UAE" },
  { code: "+966", iso: "sa", name: "Saudi Arabia" },
  { code: "+92", iso: "pk", name: "Pakistan" },
  { code: "+91", iso: "in", name: "India" },
  { code: "+49", iso: "de", name: "Germany" },
  { code: "+33", iso: "fr", name: "France" },
  { code: "+974", iso: "qa", name: "Qatar" },
  { code: "+90", iso: "tr", name: "Turkey" },
  { code: "+55", iso: "br", name: "Brazil" },
  { code: "+81", iso: "jp", name: "Japan" },
  { code: "+86", iso: "cn", name: "China" },
  { code: "+39", iso: "it", name: "Italy" },
  { code: "+34", iso: "es", name: "Spain" },
  { code: "+31", iso: "nl", name: "Netherlands" },
  { code: "+41", iso: "ch", name: "Switzerland" },
  { code: "+65", iso: "sg", name: "Singapore" },
  { code: "+64", iso: "nz", name: "New Zealand" },
  { code: "+20", iso: "eg", name: "Egypt" },
  { code: "+27", iso: "za", name: "South Africa" },
  { code: "+60", iso: "my", name: "Malaysia" },
  { code: "+63", iso: "ph", name: "Philippines" },
  { code: "+52", iso: "mx", name: "Mexico" }
];
---

<div class:list={["country-phone-wrapper relative flex items-center transition-all focus-within:ring-2 focus-within:ring-[#3D2E61]", wrapperClass]}>
  
  <!-- Country Selector Dropdown Trigger -->
  <div class="relative shrink-0">
    <button
      type="button"
      class="country-dropdown-btn flex items-center gap-1.5 px-1 sm:px-2 py-1.5 text-xs sm:text-sm font-semibold text-slate-700 hover:text-slate-900 border-r border-slate-300 pr-2.5 mr-2 select-none cursor-pointer focus:outline-none rounded-lg hover:bg-black/5 transition-colors"
      aria-label="Select Country Code"
      aria-haspopup="listbox"
      aria-expanded="false"
    >
      <!-- Flag Icon Image -->
      <img
        src="/flags/us.png"
        alt="United States Flag"
        class="selected-flag-img w-5 h-3.5 object-cover rounded-[2px] shadow-xs shrink-0"
      />
      <!-- Dial Code -->
      <span class="selected-dial-code font-bold text-slate-800 text-xs sm:text-sm">+1</span>
      <!-- Down Chevron -->
      <svg class="dropdown-chevron w-3 h-3 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <!-- Hidden Input for Form Submission -->
    <input type="hidden" name={`${name}_country_code`} class="country-code-hidden" value="+1" />

    <!-- Country Dropdown Popover Menu -->
    <div class="country-dropdown-menu hidden absolute top-[calc(100%+8px)] left-0 w-64 sm:w-72 max-h-72 bg-white border border-slate-200 rounded-2xl shadow-2xl z-50 overflow-hidden flex flex-col font-montserrat">
      <!-- Search Box -->
      <div class="p-2.5 border-b border-slate-100 bg-slate-50/80">
        <div class="relative flex items-center">
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            placeholder="Search country or code..."
            class="country-search-input w-full pl-8 pr-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#3D2E61]/30 focus:border-[#3D2E61]"
          />
        </div>
      </div>

      <!-- Countries List -->
      <div class="country-options-list overflow-y-auto max-h-56 divide-y divide-slate-100/60 py-1">
        {countryCodes.map((c) => (
          <button
            type="button"
            class="country-option-item w-full px-3.5 py-2 text-left flex items-center gap-2.5 hover:bg-purple-50 active:bg-purple-100 transition-colors text-xs text-slate-800 cursor-pointer"
            data-code={c.code}
            data-iso={c.iso}
            data-name={c.name}
          >
            <img
              src={`/flags/${c.iso}.png`}
              alt={c.name}
              class="w-5 h-3.5 object-cover rounded-[2px] shadow-xs shrink-0"
              loading="lazy"
            />
            <span class="country-option-name font-medium text-slate-700 flex-1 truncate">{c.name}</span>
            <span class="font-bold text-slate-500 text-xs shrink-0">{c.code}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Main Phone Number Input -->
  <input
    type="tel"
    id={id}
    name={name}
    placeholder={placeholder}
    required={required}
    class:list={["w-full bg-transparent border-0 placeholder:text-slate-400 focus:outline-none", inputClass]}
  />
</div>

<script>
  function setupCountryPhoneInputs() {
    const wrappers = document.querySelectorAll('.country-phone-wrapper');
    
    wrappers.forEach((wrapper) => {
      if (wrapper.hasAttribute('data-initialized')) return;
      wrapper.setAttribute('data-initialized', 'true');

      const btn = wrapper.querySelector('.country-dropdown-btn') as HTMLButtonElement | null;
      const menu = wrapper.querySelector('.country-dropdown-menu') as HTMLElement | null;
      const chevron = wrapper.querySelector('.dropdown-chevron') as SVGElement | null;
      const flagImg = wrapper.querySelector('.selected-flag-img') as HTMLImageElement | null;
      const dialCode = wrapper.querySelector('.selected-dial-code') as HTMLElement | null;
      const hiddenCode = wrapper.querySelector('.country-code-hidden') as HTMLInputElement | null;
      const searchInput = wrapper.querySelector('.country-search-input') as HTMLInputElement | null;
      const optionItems = wrapper.querySelectorAll('.country-option-item');

      function toggleMenu(show?: boolean) {
        const isCurrentlyHidden = menu?.classList.contains('hidden');
        const shouldOpen = show !== undefined ? show : isCurrentlyHidden;

        if (shouldOpen) {
          // Close other open country menus
          document.querySelectorAll('.country-dropdown-menu').forEach((m) => {
            if (m !== menu) m.classList.add('hidden');
          });
          document.querySelectorAll('.dropdown-chevron').forEach((c) => {
            if (c !== chevron) c.classList.remove('rotate-180');
          });

          menu?.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
          btn?.setAttribute('aria-expanded', 'true');

          if (searchInput) {
            searchInput.value = '';
            filterOptions('');
            setTimeout(() => searchInput.focus(), 60);
          }
        } else {
          menu?.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
          btn?.setAttribute('aria-expanded', 'false');
        }
      }

      function filterOptions(query: string) {
        const q = query.toLowerCase().trim();
        optionItems.forEach((item) => {
          const name = item.getAttribute('data-name')?.toLowerCase() || '';
          const code = item.getAttribute('data-code')?.toLowerCase() || '';
          if (name.includes(q) || code.includes(q)) {
            (item as HTMLElement).style.display = 'flex';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      }

      btn?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggleMenu();
      });

      searchInput?.addEventListener('input', (e) => {
        filterOptions((e.target as HTMLInputElement).value);
      });

      searchInput?.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      optionItems.forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const code = opt.getAttribute('data-code') || '+1';
          const iso = opt.getAttribute('data-iso') || 'us';
          const name = opt.getAttribute('data-name') || 'United States';

          if (flagImg) {
            flagImg.src = `/flags/${iso}.png`;
            flagImg.alt = `${name} Flag`;
          }
          if (dialCode) dialCode.textContent = code;
          if (hiddenCode) hiddenCode.value = code;

          toggleMenu(false);
        });
      });

      // Close when clicking anywhere outside
      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target as Node)) {
          toggleMenu(false);
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleMenu(false);
        }
      });
    });
  }

  // Initialize on load and DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCountryPhoneInputs);
  } else {
    setupCountryPhoneInputs();
  }
</script>
