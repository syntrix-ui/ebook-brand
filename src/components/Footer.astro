---
// Footer.astro - Matching original Figma footer specifications exactly with functional links
---

<footer class="w-full bg-[#3D2E61] text-white font-montserrat pt-12 sm:pt-14 pb-12 sm:pb-16 overflow-hidden border-t border-white/10">
  <div class="max-w-[1350px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Footer Grid (3 Columns) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 lg:gap-14 items-start">
      
      <!-- Column 1: QUICK LINKS -->
      <div class="flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <h3 class="text-white font-bold text-sm sm:text-[15px] lg:text-base tracking-wider uppercase">
            QUICK LINKS
          </h3>
          <ul class="space-y-2.5 text-xs sm:text-[13px] font-medium text-white/85 tracking-wide uppercase">
            <li>
              <a href="/" class="hover:text-white transition-colors duration-150 inline-block">
                HOME
              </a>
            </li>
            <li>
              <a href="/about" class="hover:text-white transition-colors duration-150 inline-block">
                ABOUT US
              </a>
            </li>
            <li>
              <a href="/book-publishing" class="hover:text-white transition-colors duration-150 inline-block">
                SERVICES
              </a>
            </li>
            <li>
              <a href="/faqs" class="hover:text-white transition-colors duration-150 inline-block">
                FAQS
              </a>
            </li>
            <li>
              <a href="/blog" class="hover:text-white transition-colors duration-150 inline-block">
                BLOG
              </a>
            </li>
            <li>
              <a href="/contact" class="hover:text-white transition-colors duration-150 inline-block">
                CONTACT
              </a>
            </li>
          </ul>
        </div>

        <!-- Subscribe To Newsletter -->
        <div class="pt-4 sm:pt-6">
          <a 
            href="/contact" 
            class="text-white font-bold text-xs sm:text-[14px] lg:text-[15px] tracking-wider uppercase hover:text-purple-200 transition-colors inline-block"
          >
            SUBSCRIBE TO NEWSLETTER
          </a>
        </div>

        <!-- Copyright -->
        <div class="pt-6 sm:pt-10 text-[10px] sm:text-[11px] font-medium tracking-wider text-white/80 uppercase">
          FLECK&copy; 2026 ALL RIGHTS RESERVED
        </div>
      </div>

      <!-- Column 2: CATEGORY -->
      <div class="space-y-4">
        <h3 class="text-white font-bold text-sm sm:text-[15px] lg:text-base tracking-wider uppercase">
          CATEGORY
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-[13px] font-medium text-white/85 tracking-wide uppercase">
          <li>
            <a href="/book-editing" class="hover:text-white transition-colors duration-150 inline-block">
              BOOK EDITING
            </a>
          </li>
          <li>
            <a href="/proofreading" class="hover:text-white transition-colors duration-150 inline-block">
              PROOFING
            </a>
          </li>
          <li>
            <a href="/book-writing" class="hover:text-white transition-colors duration-150 inline-block">
              CONTENT
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: ABOUT US, SOCIAL ICONS & CONTACT US -->
      <div class="space-y-7 max-w-sm">
        
        <!-- About Us & Social Media Icons Row -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-white font-bold text-sm sm:text-[15px] lg:text-base tracking-wider uppercase">
              ABOUT US
            </h3>
            
            <!-- Social Icons (Instagram, Facebook, X, LinkedIn) -->
            <div class="flex items-center gap-3.5 sm:gap-4 text-white">
              <!-- Instagram -->
              <a 
                href="https://instagram.com" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="Instagram" 
                class="hover:text-purple-300 transition-colors p-1"
              >
                <svg class="w-4 h-4 sm:w-[18px] sm:h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                </svg>
              </a>

              <!-- Facebook -->
              <a 
                href="https://facebook.com" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="Facebook" 
                class="hover:text-purple-300 transition-colors p-1"
              >
                <svg class="w-4 h-4 sm:w-[18px] sm:h-[18px]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.667 5H18V0h-3.808C10.596 0 9 1.583 9 4.615V8z"/>
                </svg>
              </a>

              <!-- X (Twitter) -->
              <a 
                href="https://x.com" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="X" 
                class="hover:text-purple-300 transition-colors p-1"
              >
                <svg class="w-3.5 h-3.5 sm:w-[16px] sm:h-[16px]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>

              <!-- LinkedIn -->
              <a 
                href="https://linkedin.com" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="LinkedIn" 
                class="hover:text-purple-300 transition-colors p-1"
              >
                <svg class="w-4 h-4 sm:w-[18px] sm:h-[18px]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                </svg>
              </a>
            </div>
          </div>

          <ul class="space-y-2.5 text-xs sm:text-[13px] font-medium text-white/85 tracking-wide uppercase">
            <li>
              <a href="/contact" class="hover:text-white transition-colors duration-150 inline-block">
                PRIVACY POLICY
              </a>
            </li>
            <li>
              <a href="/contact" class="hover:text-white transition-colors duration-150 inline-block">
                TERMS AND CONDITION
              </a>
            </li>
            <li>
              <a href="/contact" class="hover:text-white transition-colors duration-150 inline-block">
                COOKIE POLICY
              </a>
            </li>
          </ul>
        </div>

        <!-- Contact Us Section -->
        <div class="space-y-3.5 pt-2">
          <h3 class="text-white font-bold text-sm sm:text-[15px] lg:text-base tracking-wider uppercase">
            CONTACT US
          </h3>
          
          <div class="space-y-2.5 text-xs sm:text-[13px] font-medium tracking-wide">
            <!-- PHONE Row -->
            <div class="flex items-start gap-2">
              <span class="text-white font-semibold uppercase shrink-0">PHONE:</span>
              <a 
                href="tel:+18048436684" 
                class="text-purple-100 hover:text-white transition-colors font-medium"
              >
                +1 804 843 6684
              </a>
            </div>
            
            <!-- ADDRESS Row -->
            <div class="flex items-start gap-2 pt-1">
              <span class="text-white font-semibold uppercase shrink-0">ADDRESS:</span>
              <span class="text-white/85 leading-relaxed font-normal max-w-[260px]">
                178-10 Wexford Terrace, Apt 2K, Jamaica, NY 11432, Jamaica, NY, United States
              </span>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</footer>
