---
// AboutHero.astro - Hero Section with customizable props
import CountryPhoneInput from './CountryPhoneInput.astro';

interface Props {
  badge?: string;
  subtitle?: string;
  titleNormal?: string;
  titleBold?: string;
  desc?: string;
  serviceTag?: string;
  bgImg?: string;
  showForm?: boolean;
  lightOverlay?: boolean;
}

const {
  subtitle = "Professional Book Publishing Services",
  titleNormal = "for Aspiring ",
  titleBold = "Authors",
  desc = "We place your book where it matters—readers, retailers, libraries, and platforms that drive real discovery. No noise, no fluff—just clean execution that gets your book picked, stocked, and sold.",
  serviceTag = "Book Publishing",
  bgImg = "/Container.png",
  showForm = true,
  lightOverlay = false
} = Astro.props;
---

<section 
  class="relative w-full min-h-screen bg-cover bg-right lg:bg-center flex items-center pt-32 sm:pt-36 lg:pt-40 pb-16 lg:pb-24 font-montserrat overflow-hidden" 
  style={`background-image: url('${bgImg}'); background-color: #0b090e;`}
>
  <div class:list={[
    "absolute inset-0 -z-0",
    lightOverlay 
      ? "bg-gradient-to-r from-black/70 via-black/45 to-black/20" 
      : "bg-gradient-to-r from-black/95 via-black/85 to-black/75"
  ]}></div>

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 w-full relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Left Column: Content, Consultation Banner & Trust Badges -->
    <div class:list={[showForm ? "lg:col-span-7" : "lg:col-span-8 xl:col-span-7", "space-y-6 text-white"]}>
      
      <!-- Subtitle -->
      <h3 class="text-base sm:text-xl lg:text-2xl font-medium tracking-tight text-white/90">
        {subtitle}
      </h3>

      <!-- Main Headline -->
      <h1 class="font-nunito text-4xl sm:text-5xl xl:text-[60px] font-bold tracking-tight leading-[1.12] text-white line-clamp-2 max-w-3xl">
        <span class="block">{titleNormal}</span>
        <span class="text-white block">{titleBold}</span>
      </h1>

      <!-- Description Paragraph -->
      <p class="text-slate-200/90 text-xs sm:text-sm lg:text-[15px] leading-relaxed max-w-xl font-normal">
        {desc}
      </p>

      <!-- Consultation Banner (Pill Design with Arrow Cap) -->
      <a 
        href="#book-consultation" 
        class="w-full max-w-lg rounded-[22px] sm:rounded-[26px] overflow-hidden flex items-stretch shadow-2xl border border-white/10 group cursor-pointer hover:shadow-orange-950/40 transition-all block"
      >
        <!-- Left Brown Body -->
        <div class="bg-[#943C00] text-white px-5 sm:px-6 py-4 flex-1 flex flex-col justify-center space-y-1">
          <h4 class="text-white text-sm sm:text-base lg:text-lg font-bold leading-snug tracking-tight">
            Get free 1 hour consultation valued at $250
          </h4>
          <p class="text-white/90 text-[11px] sm:text-xs font-normal leading-tight">
            Send us your details and our consultant will reach you back at your specified time.
          </p>
        </div>

        <!-- Right Beige Pill Cap with Arrow -->
        <div class="w-14 sm:w-16 bg-[#E8D9CB] flex items-center justify-center shrink-0 group-hover:bg-[#dfcdbd] transition-colors">
          <svg class="w-6 h-6 text-[#943C00] stroke-[2.5] transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

      <!-- Book Now Button -->
      <div class="pt-1">
        <a 
          href="#book-consultation" 
          class="inline-flex items-center justify-center px-7 sm:px-9 py-2.5 sm:py-3 bg-white text-slate-900 font-bold text-xs sm:text-sm rounded-lg hover:bg-slate-100 hover:shadow-xl active:scale-[0.98] transition-all duration-200 cursor-pointer shadow-md"
        >
          Book Now
        </a>
      </div>

      <!-- Social Proof / Join Badge Line -->
      <div class="space-y-3 pt-2">
        <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-semibold text-white/90">
          <span>Join</span>
          <img src="/icons/fluent-color_star-16.svg" alt="Star Icon" class="w-4 h-4 shrink-0" />
          <span class="text-white font-bold">2,389+</span>
          <span class="text-slate-200 font-medium">Writers Who Got Their Book Published.</span>
        </div>

        <!-- Logos Row: Google My Business, Bark, Reviews.io (100px height matching Figma) -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-7 pt-2">
          <!-- Google My Business Logo (100x100) -->
          <div class="flex items-center justify-center h-[85px] sm:h-[100px] shrink-0">
            <img 
              src="/icons/google-my-business.png" 
              alt="Google My Business" 
              class="h-[85px] sm:h-[100px] w-auto object-contain" 
            />
          </div>

          <!-- Bark Logo (100x100) -->
          <div class="flex items-center justify-center h-[85px] sm:h-[100px] shrink-0">
            <img 
              src="/icons/bark.png" 
              alt="Bark" 
              class="h-[85px] sm:h-[100px] w-auto object-contain" 
            />
          </div>

          <!-- Reviews.io Logo (124x100) -->
          <div class="flex items-center justify-center h-[85px] sm:h-[100px] shrink-0">
            <img 
              src="/icons/reviews-io.png" 
              alt="Reviews.io" 
              class="h-[85px] sm:h-[100px] w-auto object-contain" 
            />
          </div>
        </div>
      </div>

    </div>

    <!-- Right Column: Consultation Form Card -->
    {showForm && (
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div 
          id="book-consultation" 
          class="w-full max-w-[460px] bg-white rounded-[28px] sm:rounded-[36px] p-6 sm:p-8 lg:p-9 shadow-2xl text-slate-900 border border-slate-100/20 font-montserrat relative z-20"
        >
          
          <!-- Form Header -->
          <div class="text-center space-y-1 mb-5 sm:mb-6">
            <h2 class="text-2xl sm:text-[28px] font-bold text-[#2F2148] leading-tight line-clamp-2">
              Up to 50% Off On All Services!
            </h2>
            <p class="text-[#2F2148]/80 text-xs sm:text-sm font-bold tracking-wide">
              Limited Time Only
            </p>
          </div>

          <!-- Form Elements -->
          <form class="space-y-3.5" id="abouthero-submit-form">
            
            <!-- Full Name Input -->
            <div>
              <input 
                type="text" 
                placeholder="Full Name*" 
                required
                class="w-full bg-[#F0EFF4] border-0 rounded-xl px-4 py-3 sm:py-3.5 text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all"
              />
            </div>

            <!-- Phone Number input with country selector & flag icons -->
            <CountryPhoneInput 
              id="about-hero-phone"
              name="phone"
              placeholder="Phone Number"
              required={true}
              wrapperClass="bg-[#F0EFF4] rounded-xl px-3 py-1 border-0"
              inputClass="py-2.5 sm:py-3 text-xs sm:text-sm font-medium text-slate-800"
            />

            <!-- Email Input -->
            <div>
              <input 
                type="email" 
                placeholder="Email*" 
                required
                class="w-full bg-[#F0EFF4] border-0 rounded-xl px-4 py-3 sm:py-3.5 text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all"
              />
            </div>

            <!-- Select Services Checklist Section -->
            <div class="pt-1">
              <label class="block text-xs font-semibold text-slate-700 mb-2">
                Select Services
              </label>
              
              <div class="grid grid-cols-2 gap-2 sm:gap-2.5">
                
                <!-- Checkbox Item 1 (Service Tag - Checked default) -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" checked class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">{serviceTag}</span>
                </label>

                <!-- Checkbox Item 2 (Marketing) -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Marketing</span>
                </label>

                <!-- Checkbox Item 3 (Writing) -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Writing</span>
                </label>

                <!-- Checkbox Item 4 (Trailer Service) -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Trailer Service</span>
                </label>

                <!-- Checkbox Item 5 (Editing Services) -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Editing Services</span>
                </label>

                <!-- Checkbox Item 6 (Design Services) -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Design Services</span>
                </label>

              </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
              <button 
                type="submit" 
                id="abouthero-submit-btn"
                class="w-full bg-[#352554] hover:bg-[#432f6b] active:scale-[0.99] text-white font-bold text-sm sm:text-base py-3 sm:py-3.5 rounded-xl shadow-lg transition-all duration-200 cursor-pointer"
              >
                Submit
              </button>
            </div>

          </form>

          <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
              const form = document.getElementById('abouthero-submit-form');
              const btn = document.getElementById('abouthero-submit-btn');
              if (form && btn) {
                form.addEventListener('submit', (e) => {
                  e.preventDefault();
                  const originalText = btn.textContent;
                  btn.textContent = 'Submitting...';
                  btn.disabled = true;
                  setTimeout(() => {
                    btn.textContent = '✓ Thank You! We Will Contact You Shortly';
                    btn.classList.remove('bg-[#352554]', 'hover:bg-[#432f6b]');
                    btn.classList.add('bg-emerald-700');
                    form.reset();
                    setTimeout(() => {
                      btn.textContent = originalText;
                      btn.disabled = false;
                      btn.classList.remove('bg-emerald-700');
                      btn.classList.add('bg-[#352554]', 'hover:bg-[#432f6b]');
                    }, 4000);
                  }, 700);
                });
              }
            });
          </script>

        </div>
      </div>
    )}

  </div>
</section>
