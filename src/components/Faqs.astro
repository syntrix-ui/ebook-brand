---
// Faqs.astro - Frequently Asked Questions (FAQs) Section
import FaqAccordion from './FaqAccordion';

interface FaqItem {
  id: number;
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  items?: FaqItem[];
  showViewAll?: boolean;
}

const {
  title = "Frequently Asked Questions (FAQs)",
  description = "",
  items,
  showViewAll = true
} = Astro.props;
---

<section id="faqs" class="w-full bg-white py-16 sm:py-24 text-slate-900 font-montserrat border-t border-slate-100 relative">
  <div class="max-w-[1350px] mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center space-y-3 mb-10 sm:mb-14">
      
      <!-- Main Heading -->
      <h2 class="font-nunito font-bold text-3xl sm:text-5xl text-[#3D2E61] leading-tight">
        {title}
      </h2>

      <!-- Description Paragraph (rendered only if provided) -->
      {description && (
        <p class="font-montserrat text-xs sm:text-sm text-slate-800 leading-relaxed font-normal">
          {description}
        </p>
      )}

    </div>

    <!-- Interactive FAQ Accordion List -->
    <div>
      <FaqAccordion client:load items={items} />
    </div>

    <!-- View All Button -->
    {showViewAll && (
      <div class="mt-10 sm:mt-12 text-center">
        <a 
          href="/faqs" 
          class="inline-flex items-center justify-center px-7 py-2.5 bg-[#3D2E61] hover:bg-[#4d3a7a] active:scale-[0.99] text-white font-bold text-xs rounded-lg shadow-sm transition-all duration-200"
        >
          View All
        </a>
      </div>
    )}

  </div>
</section>
