---
// AboutShowcase.astro - Publish Beautiful Books Showcase Section
interface Props {
  headline?: [string, string, string];
  desc?: string;
  btnText?: string;
  collageImg?: string;
}

const {
  headline = [
    "Publish Beautiful Books That",
    "Captivate Readers and",
    "Reach Readers 3X Faster"
  ],
  desc = "From concept development and ghostwriting to award-winning cover design and strategic worldwide distribution, Fleck Publisher ensures your manuscript stands out on global bookstore shelves and digital readers alike.",
  btnText = "Get Started",
  collageImg = "/Group 66.png"
} = Astro.props;
---

<section class="w-full bg-white py-16 sm:py-24 text-slate-900 font-montserrat relative overflow-hidden">
  <div class="max-w-[1350px] mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <!-- Left Column: Copy & CTA -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Main Headline -->
        <h2 class="font-nunito font-normal font-[400] text-3xl sm:text-4xl lg:text-[44px] leading-[1.2] text-slate-900 tracking-tight">
          {headline[0]} <br class="hidden sm:inline" />
          {headline[1]} <br class="hidden sm:inline" />
          {headline[2]}
        </h2>

        <!-- Description Paragraph -->
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal max-w-xl">
          {desc}
        </p>

        <!-- CTA Button -->
        <div class="pt-2">
          <a 
            href="#book-consultation" 
            class="inline-flex items-center justify-center px-8 py-3.5 bg-[#3D2E61] hover:bg-[#4d3a7a] active:scale-[0.99] text-white font-bold text-xs sm:text-sm rounded-xl shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer"
          >
            {btnText}
          </a>
        </div>

      </div>

      <!-- Right Column: Book Covers Showcase Collage matching Group 66 / Group 72-79 -->
      <div class="lg:col-span-6 flex justify-center lg:justify-end items-center">
        <img 
          src={collageImg} 
          alt="Published Books Showcase" 
          class="w-full max-w-[500px] h-auto object-contain select-none"
        />
      </div>

    </div>
  </div>
</section>
