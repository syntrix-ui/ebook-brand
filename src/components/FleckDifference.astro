---
// FleckDifference.astro - The Fleck Difference Section
interface DifferenceCard {
  num: string;
  title: string;
  desc: string;
  bullets: string[];
  quote?: string;
}

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  cards?: DifferenceCard[];
}

const defaultDifferences: DifferenceCard[] = [
  {
    num: "01",
    title: "Distribution that covers more ground",
    desc: "We place your ebook on relevant platforms you approve of, from where it reaches global markets.",
    bullets: [
      "No duplicate uploads",
      "No format errors",
      "No regional blind spots"
    ]
  },
  {
    num: "02",
    title: "Files that pass inspection the first time",
    desc: "We format for reflowable and fixed layouts, with full platform compliance. And we publish once cleanly.",
    bullets: [
      "Kindle, EPUB, PDF all tested",
      "Metadata and ISBNs done right",
      "Uploads that clear in one go"
    ]
  },
  {
    num: "03",
    title: "Metadata with strategic weight",
    desc: "We optimize your keywords, categories, and author listings.",
    bullets: [
      "Your book lands on the right shelf",
      "Search visibility increases",
      "Pure book SMM, not guesswork"
    ]
  }
];

const {
  badge = "THE DIFFERENCE",
  title = "The Fleck Difference",
  subtitle = "Our publishing work focuses on accuracy, discoverability and technical setup across every major platform.",
  cards = defaultDifferences
} = Astro.props;
---

<section class="w-full bg-white py-16 sm:py-24 text-slate-900 font-montserrat border-t border-slate-100">
  <div class="max-w-[1350px] mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class:list={["text-center space-y-4 max-w-3xl mx-auto", (title || subtitle) ? "mb-14 sm:mb-20" : "mb-8 sm:mb-12"]}>
      
      <!-- Top Subtitle -->
      {badge && (
        <div>
          <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-[#3D2E61] font-montserrat block">
            {badge}
          </span>
        </div>
      )}

      <!-- Main Headline -->
      {title && (
        <h2 class="font-nunito font-bold text-3xl sm:text-5xl lg:text-[46px] leading-tight text-slate-900 tracking-tight line-clamp-2">
          {title}
        </h2>
      )}

      <!-- Subtitle -->
      {subtitle && (
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal max-w-xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>

    <!-- Difference Cards Grid (adaptive for 2 or 3 cards) -->
    <div class:list={["grid gap-6 lg:gap-8", cards.length === 2 ? "grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto" : "grid-cols-1 md:grid-cols-3"]}>
      {cards.map((d) => (
        <div class="bg-white rounded-[24px] p-7 sm:p-8 border border-slate-200/90 shadow-[0_4px_24px_rgba(0,0,0,0.03)] hover:shadow-[0_12px_32px_rgba(61,46,97,0.1)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group h-full relative overflow-hidden">
          
          <!-- Soft Gradient Blur in Top-Right Corner matching Figma -->
          <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#E2DFEB]/90 rounded-full blur-2xl pointer-events-none"></div>
          <div class="absolute top-0 right-0 w-28 h-28 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-slate-200/60 via-purple-100/30 to-transparent rounded-tr-[24px] pointer-events-none"></div>

          <div class="relative z-10">
            <!-- Top Row: Title on Left, Squircle Badge on Right -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-nunito font-bold text-xl sm:text-[22px] text-slate-900 leading-snug tracking-tight">
                {d.title}
              </h3>

              <div class="w-8 h-8 rounded-[12px] bg-slate-100/90 border border-slate-200/80 flex items-center justify-center text-[11px] font-semibold text-slate-500 shadow-xs shrink-0 mt-0.5">
                {d.num}
              </div>
            </div>

            <!-- Introductory Description -->
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-normal mb-5">
              {d.desc}
            </p>

            <!-- Bullet List with purple dots -->
            <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-700 font-normal">
              {d.bullets.map((b) => (
                <li class="flex items-center gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#3D2E61] shrink-0"></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>

            <!-- Optional Closing Takeaway Quote -->
            {d.quote && (
              <p class="text-xs sm:text-[13px] text-slate-600 font-medium leading-relaxed mt-5 pt-3 border-t border-slate-100">
                {d.quote}
              </p>
            )}
          </div>

          <!-- Bottom Row: FLECK STANDARD Label & Single Progress Bar filling on hover -->
          <div class="pt-8 mt-8 border-t border-slate-100/80 flex items-center justify-between text-[11px] font-bold text-slate-400 group-hover:text-slate-600 transition-colors tracking-wider uppercase relative z-10">
            <span>FLECK STANDARD</span>
            
            <!-- Single progress bar track that fills up completely on card hover -->
            <div class="w-9 h-1.5 rounded-full bg-slate-200 overflow-hidden relative">
              <div class="h-full bg-[#3D2E61] rounded-full w-4 group-hover:w-full transition-all duration-300 ease-out"></div>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
