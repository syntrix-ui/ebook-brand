---
// Roadmap.astro - Have An Amazing Idea? We Have The Roadmap Section
import CountryPhoneInput from './CountryPhoneInput.astro';
---

<section id="book-consultation" class="w-full bg-white py-16 sm:py-24 text-slate-900 font-montserrat border-t border-slate-100 relative scroll-mt-24">
  <div class="max-w-[1350px] mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <!-- Left Column: Text Content -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Headline -->
        <h2 class="font-nunito font-semibold text-3xl sm:text-4xl lg:text-[42px] leading-[1.2] text-[#3D2E61] max-w-xl line-clamp-2">
          Have An Amazing Idea? We Have The Roadmap To Make It Happen!
        </h2>

        <!-- Description Paragraphs -->
        <p class="text-xs sm:text-sm text-slate-800 leading-relaxed font-normal">
          working with fleck publisher gives you access to 1:1 coaching and support sessions with expert ghostwriters, experienced literary agents and beta testing readers who'll navigate the publishing maze for you by refining your ideas, preserving your tone of voice,
        </p>

        <p class="text-xs sm:text-sm text-slate-800 leading-relaxed font-normal">
          highlighting your original message and strategizing your overall process so you can focus on developing authorship globally with full control, creativity, confidence and credit!
        </p>

      </div>

      <!-- Right Column: Consultation Form Card -->
      <div class="lg:col-span-6 flex justify-center lg:justify-end">
        
        <div class="w-full max-w-[460px] bg-white rounded-[28px] p-6 sm:p-8 shadow-2xl border border-slate-200/80 relative font-montserrat">
          
          <!-- Top Multi-color Gradient Border Line -->
          <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-[#3D2E61] via-purple-500 to-amber-500 rounded-t-[28px]"></div>

          <!-- Form Header -->
          <div class="text-center pt-2 mb-6">
            <h3 class="font-nunito font-bold text-xl sm:text-2xl text-[#3D2E61] leading-tight">
              Book Now for a Free Consultation Call
            </h3>
          </div>

          <!-- Form Elements -->
          <form id="roadmap-form" class="space-y-4">
            
            <!-- Full Name -->
            <div>
              <input 
                type="text" 
                placeholder="Full Name*" 
                required
                class="w-full bg-[#F0EFF4] border-0 rounded-xl px-4 py-3.5 text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all"
              />
            </div>

            <!-- Phone Input with International Selector & Real Flag Icons -->
            <CountryPhoneInput 
              id="roadmap-phone"
              name="phone"
              placeholder="Phone Number"
              required={true}
              wrapperClass="bg-[#F0EFF4] rounded-xl px-3 py-1 border-0"
              inputClass="py-2.5 text-xs sm:text-sm font-medium text-slate-800"
            />

            <!-- Email -->
            <div>
              <input 
                type="email" 
                placeholder="Email*" 
                required
                class="w-full bg-[#F0EFF4] border-0 rounded-xl px-4 py-3.5 text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all"
              />
            </div>

            <!-- Select Services Checklist Section -->
            <div class="pt-1">
              <label class="block text-xs font-semibold text-slate-700 mb-2">
                Select Services:
              </label>
              
              <div class="grid grid-cols-2 gap-2.5">
                
                <!-- Checkbox Item 1 (Checked default) -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" checked class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Publishing</span>
                </label>

                <!-- Checkbox Item 2 -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Marketing</span>
                </label>

                <!-- Checkbox Item 3 -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Writing</span>
                </label>

                <!-- Checkbox Item 4 -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Trailer Service</span>
                </label>

                <!-- Checkbox Item 5 -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Editing Services</span>
                </label>

                <!-- Checkbox Item 6 -->
                <label class="flex items-center gap-2 bg-[#F0EFF4] p-2.5 sm:p-3 rounded-xl cursor-pointer hover:bg-slate-200/80 transition-colors">
                  <input type="checkbox" class="w-4 h-4 rounded text-[#3D2E61] focus:ring-[#3D2E61] accent-[#3D2E61]" />
                  <span class="text-[11px] sm:text-xs font-semibold text-slate-800">Design Services</span>
                </label>

              </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-3 flex flex-col items-center gap-2">
              <button 
                id="roadmap-submit-btn"
                type="submit" 
                class="w-full bg-[#3D2E61] hover:bg-[#4d3a7a] active:scale-[0.99] text-white font-bold text-sm sm:text-base py-3.5 rounded-xl shadow-lg transition-all duration-200 cursor-pointer"
              >
                Submit
              </button>
              <p id="roadmap-success-msg" class="text-xs font-semibold text-emerald-700 hidden text-center pt-1">
                ✓ Consultation request received! A senior publishing consultant will call you shortly.
              </p>
            </div>

          </form>

        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const rForm = document.getElementById('roadmap-form');
  const rBtn = document.getElementById('roadmap-submit-btn');
  const rMsg = document.getElementById('roadmap-success-msg');

  if (rForm && rBtn && rMsg) {
    rForm.addEventListener('submit', (e) => {
      e.preventDefault();
      rBtn.innerText = 'Request Sent!';
      rBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
      rBtn.classList.remove('bg-[#3D2E61]', 'hover:bg-[#4d3a7a]');
      rMsg.classList.remove('hidden');
    });
  }
</script>
