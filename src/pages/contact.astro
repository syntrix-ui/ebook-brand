---
// contact.astro - Contact Us Page matching site styling with consultation form and SuccessStories carousel
import '../styles/globals.css';
import Header from '../components/Header.astro';
import CountryPhoneInput from '../components/CountryPhoneInput.astro';
import SuccessStories from '../components/SuccessStories.astro';
import Footer from '../components/Footer.astro';

const servicesList = [
  "Book Writing & Ghostwriting",
  "Book Editing & Proofreading",
  "Book Cover & Interior Design",
  "Amazon & Book Publishing",
  "eBook Marketing & BookTok",
  "Cinematic Book Trailer",
  "Author Coaching & Mentoring",
  "ISBN & Distribution Setup"
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Contact Fleck Publisher - Get in touch with our book publishing specialists for a free 1-hour consultation valued at $250. Writing, editing, design, publishing, and marketing." />
    <title>Contact Us - Fleck Publisher | Book Publishing Services</title>

    <!-- Google Fonts Montserrat & Nunito Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300..900;1,300..900&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-[#FAF9FC] text-slate-900 font-montserrat selection:bg-[#3D2E61] selection:text-white relative overflow-x-hidden">
    
    <!-- Top Dark Purple Bar with Header -->
    <div class="w-full bg-[#1E1435] relative">
      <div class="h-28 sm:h-32">
        <Header />
      </div>
    </div>

    <!-- Hero Header Banner Section -->
    <section class="w-full bg-gradient-to-b from-[#1E1435] to-[#2B1B4D] text-white py-14 sm:py-20 px-4 sm:px-6 relative overflow-hidden">
      <!-- Ambient Glow Decor -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-purple-600/20 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="max-w-[1300px] mx-auto text-center relative z-10 space-y-4">
        <h1 class="font-nunito font-bold text-3xl sm:text-5xl lg:text-[52px] text-white tracking-tight leading-tight line-clamp-2 max-w-3xl mx-auto">
          Let's Bring Your Book to Life
        </h1>

        <p class="font-montserrat text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
          Whether you have an unwritten concept, a finished draft, or a published title ready for aggressive marketing, Fleck Publisher is ready to partner with you. Fill out the form below for your free consultation.
        </p>
      </div>
    </section>

    <!-- Main Content: Contact Form & Info Grid -->
    <main class="w-full py-12 sm:py-20 px-4 sm:px-6">
      <div class="max-w-[1300px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: The Contact Form (Site Design) -->
        <div class="lg:col-span-7 bg-white border border-slate-200/90 rounded-[28px] p-6 sm:p-9 lg:p-10 shadow-xl shadow-slate-200/50 space-y-7">
          
          <!-- Form Header -->
          <div class="space-y-2 border-b border-slate-100 pb-5">
            <h2 class="font-nunito font-bold text-2xl sm:text-3xl text-[#23173D] tracking-tight line-clamp-2">
              Request Free Consultation
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
              Tell us about your manuscript or project goals. Our dedicated publishing directors will evaluate your requirements and contact you within 24 hours.
            </p>
          </div>

          <form id="contact-form" class="space-y-6">
            <!-- Name & Email Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="contact-name" class="block text-xs sm:text-sm font-semibold text-slate-800">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="fullname" 
                  required 
                  placeholder="e.g. Eleanor Vance" 
                  class="w-full bg-[#F5F4F9] border border-slate-200/80 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3D2E61] focus:border-transparent transition-all"
                />
              </div>

              <div class="space-y-1.5">
                <label for="contact-email" class="block text-xs sm:text-sm font-semibold text-slate-800">
                  Email Address <span class="text-red-500">*</span>
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  required 
                  placeholder="e.g. author@example.com" 
                  class="w-full bg-[#F5F4F9] border border-slate-200/80 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3D2E61] focus:border-transparent transition-all"
                />
              </div>
            </div>

            <!-- Phone Input with Country Selector -->
            <div class="space-y-1.5">
              <label for="contact-phone" class="block text-xs sm:text-sm font-semibold text-slate-800">
                Phone Number <span class="text-red-500">*</span>
              </label>
              <CountryPhoneInput 
                id="contact-phone" 
                name="phone" 
                required={true}
                wrapperClass="bg-[#F5F4F9] border border-slate-200/80 rounded-xl px-3 py-1.5 focus-within:bg-white focus-within:ring-2 focus-within:ring-[#3D2E61]" 
                inputClass="py-2 text-xs sm:text-sm font-medium text-slate-800 placeholder-slate-400"
              />
            </div>

            <!-- Services Dropdown (Matching Site Style) -->
            <div class="space-y-1.5">
              <label for="contact-service" class="block text-xs sm:text-sm font-semibold text-slate-800">
                Services You Are Interested In
              </label>
              <select 
                id="contact-service" 
                name="service" 
                class="w-full bg-[#F5F4F9] border border-slate-200/80 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all cursor-pointer"
              >
                <option value="" disabled selected>Select a Service</option>
                {servicesList.map((service) => (
                  <option value={service}>{service}</option>
                ))}
                <option value="All-in-One Publishing Package">All-in-One Full Publishing Package</option>
              </select>
            </div>

            <!-- Stage & Budget Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="manuscript-status" class="block text-xs sm:text-sm font-semibold text-slate-800">
                  Current Manuscript Stage
                </label>
                <select 
                  id="manuscript-status" 
                  name="stage" 
                  class="w-full bg-[#F5F4F9] border border-slate-200/80 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all cursor-pointer"
                >
                  <option value="concept">Book Idea / Concept Only</option>
                  <option value="drafting">Writing In Progress</option>
                  <option value="completed" selected>Finished Manuscript Draft</option>
                  <option value="published">Already Published (Marketing/Dist)</option>
                  <option value="other">Other / Custom Requirement</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label for="project-budget" class="block text-xs sm:text-sm font-semibold text-slate-800">
                  Estimated Budget
                </label>
                <select 
                  id="project-budget" 
                  name="budget" 
                  class="w-full bg-[#F5F4F9] border border-slate-200/80 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3D2E61] transition-all cursor-pointer"
                >
                  <option value="under1k">Under $1,000</option>
                  <option value="1k-3k" selected>$1,000 – $3,000</option>
                  <option value="3k-5k">$3,000 – $5,000</option>
                  <option value="5k+">$5,000+</option>
                </select>
              </div>
            </div>

            <!-- Message / Project Details Textarea -->
            <div class="space-y-1.5">
              <label for="contact-message" class="block text-xs sm:text-sm font-semibold text-slate-800">
                Tell Us About Your Book & Goals
              </label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="4" 
                placeholder="Share your book title, genre, target word count, timeline expectations, or any specific questions you have..." 
                class="w-full bg-[#F5F4F9] border border-slate-200/80 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#3D2E61] focus:border-transparent transition-all resize-y"
              ></textarea>
            </div>

            <!-- Submit Button matching site purple CTA button -->
            <button 
              type="submit" 
              id="contact-submit-btn"
              class="w-full py-4 px-6 bg-gradient-to-r from-[#3D2E61] to-[#553E87] hover:from-[#493774] hover:to-[#63499E] text-white font-nunito font-bold text-base sm:text-lg rounded-xl shadow-lg hover:shadow-xl hover:shadow-purple-900/20 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer group"
            >
              <span>Send Message & Claim Free Consultation</span>
              <svg class="w-5 h-5 text-white/90 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <!-- Confidentiality Notice -->
            <div class="flex items-center justify-center gap-2 text-center text-[11px] sm:text-xs text-slate-500 font-medium">
              <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span>100% Confidential & Secure. Your ideas and manuscript are protected under strict NDA.</span>
            </div>

          </form>

          <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
              const form = document.getElementById('contact-form');
              const btn = document.getElementById('contact-submit-btn');
              if (form && btn) {
                form.addEventListener('submit', (e) => {
                  e.preventDefault();
                  const originalHtml = btn.innerHTML;
                  btn.innerHTML = '<span>Sending Your Request...</span>';
                  btn.disabled = true;
                  setTimeout(() => {
                    btn.innerHTML = '<span>✓ Thank You! Consultation Request Sent</span>';
                    btn.classList.remove('from-[#3D2E61]', 'to-[#553E87]');
                    btn.classList.add('bg-emerald-700');
                    form.reset();
                    setTimeout(() => {
                      btn.innerHTML = originalHtml;
                      btn.disabled = false;
                      btn.classList.remove('bg-emerald-700');
                      btn.classList.add('from-[#3D2E61]', 'to-[#553E87]');
                    }, 4000);
                  }, 700);
                });
              }
            });
          </script>

        </div>

        <!-- Right Column: Contact Details, Direct Phone, Office Info & Trust Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Card 1: Direct Contact Information -->
          <div class="bg-white border border-slate-200/90 rounded-[28px] p-6 sm:p-8 shadow-xl shadow-slate-200/50 space-y-6">
            <h3 class="font-nunito font-extrabold text-xl sm:text-2xl text-[#23173D] tracking-tight">
              Get in Touch Directly
            </h3>

            <div class="space-y-4 text-slate-700">
              <!-- Phone -->
              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-[#ECEAF5] text-[#3D2E61] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Sales & Consultation</span>
                  <a href="tel:+18048436684" class="text-base sm:text-lg font-bold text-[#23173D] hover:text-[#3D2E61] transition-colors block">
                    +1 804 843 6684
                  </a>
                  <a href="tel:+13152390990" class="text-xs sm:text-sm font-medium text-slate-500 hover:text-[#3D2E61] transition-colors block">
                    +1 (315) 239-0990 (Direct Line)
                  </a>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-[#ECEAF5] text-[#3D2E61] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Email Us</span>
                  <a href="mailto:support@fleckpublisher.com" class="text-sm sm:text-base font-semibold text-[#23173D] hover:text-[#3D2E61] transition-colors block">
                    support@fleckpublisher.com
                  </a>
                  <a href="mailto:sales@fleckpublisher.com" class="text-xs text-slate-500 hover:text-[#3D2E61] transition-colors block">
                    sales@fleckpublisher.com
                  </a>
                </div>
              </div>

              <!-- Address -->
              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-[#ECEAF5] text-[#3D2E61] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Corporate Office</span>
                  <p class="text-xs sm:text-sm font-medium text-slate-700 leading-relaxed">
                    8201 Greensboro Drive Suite 615, McLean, VA 22102
                  </p>
                </div>
              </div>

              <!-- Hours -->
              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-[#ECEAF5] text-[#3D2E61] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Operating Hours</span>
                  <p class="text-xs sm:text-sm font-medium text-slate-700">
                    Monday – Friday: 9:00 AM – 6:00 PM EST
                  </p>
                  <p class="text-[11px] text-emerald-600 font-semibold mt-0.5">
                    ● Average response time under 2 hours
                  </p>
                </div>
              </div>
            </div>
          </div>



        </div>

      </div>
    </main>

    <!-- Bottom Carousel: "aur neeche wahi hamara wala carousal lagao" -->
    <SuccessStories />

    <!-- Site Footer -->
    <Footer />

  </body>
</html>
