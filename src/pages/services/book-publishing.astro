---
// services/book-publishing.astro - Sub-route for Book Publishing Service
import '../../styles/globals.css';
import Header from '../../components/Header.astro';
import AboutHero from '../../components/AboutHero.astro';
import AboutShowcase from '../../components/AboutShowcase.astro';
import AboutManuscript from '../../components/AboutManuscript.astro';
import PublishingPlatforms from '../../components/PublishingPlatforms.astro';
import AboutTeamBanner from '../../components/AboutTeamBanner.astro';
import PublishingProcess from '../../components/PublishingProcess.astro';
import FleckDifference from '../../components/FleckDifference.astro';
import WhyChooseFleck from '../../components/WhyChooseFleck.astro';
import SuccessStories from '../../components/SuccessStories.astro';
import Roadmap from '../../components/Roadmap.astro';
import Faqs from '../../components/Faqs.astro';
import Footer from '../../components/Footer.astro';
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Book Publishing Services | Fleck Publisher - Professional Book Publishing Services for Aspiring Authors" />
    <title>Book Publishing Services | Fleck Publisher</title>

    <!-- Google Fonts Montserrat & Nunito Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300..900;1,300..900&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-[#0a080d] text-slate-100 font-montserrat selection:bg-[#3D2E61] selection:text-white relative overflow-x-hidden">
    
    <!-- Header / Navigation Bar -->
    <Header />

    <!-- Main Content Area arranged in exact sequence matching Figma design -->
    <main class="w-full">
      <!-- Section 1: Book Publishing Hero -->
      <AboutHero />

      <!-- Section 2: Book Showcase (Publish Beautiful Books...) -->
      <AboutShowcase />

      <!-- Section 3: Submit Your Manuscript (6 Cards + Dual Action Buttons) -->
      <AboutManuscript />

      <!-- Section 4: Platforms Where You Can Publish (5 Retailers) -->
      <PublishingPlatforms />

      <!-- Section 5: Inside Fleck's Publishing Department (Dark Purple Banner) -->
      <AboutTeamBanner />

      <!-- Section 6: 4-Step Book Publishing Process -->
      <PublishingProcess />

      <!-- Section 7: The Fleck Difference (3 Value Comparison Cards) -->
      <FleckDifference />

      <!-- Section 8: Why Authors Choose Fleck Publisher (With Reading Woman) -->
      <WhyChooseFleck />

      <!-- Section 9: Success Stories Carousel -->
      <SuccessStories />

      <!-- Section 10: Have An Amazing Idea? Roadmap Form -->
      <Roadmap />

      <!-- Section 11: Frequently Asked Questions (FAQs) -->
      <Faqs />
    </main>

    <!-- Section 12: Footer -->
    <Footer />

  </body>
</html>
